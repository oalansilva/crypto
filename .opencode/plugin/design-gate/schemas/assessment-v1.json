{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "design-critique-assessment.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "assessment", "lineage_id", "round", "source_digest", "resolutions", "findings"],
  "properties": {
    "schema": { "const": "design-critique-assessment.v1" },
    "assessment": { "enum": ["A", "B"] },
    "lineage_id": { "type": "string", "minLength": 1 },
    "round": { "type": "integer", "minimum": 0 },
    "source_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "resolutions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["finding_id", "prior_source_digest", "source_digest", "disposition", "rationale"],
        "properties": {
          "finding_id": { "type": "string", "minLength": 1 },
          "prior_source_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "source_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "disposition": { "enum": ["resolved", "open"] },
          "rationale": { "type": "string", "minLength": 1 }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["finding_id", "severity", "source_digest", "summary", "disposition_required"],
        "properties": {
          "finding_id": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["P0", "P1", "P2"] },
          "source_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "summary": { "type": "string", "minLength": 1 },
          "disposition_required": { "type": "boolean" }
        }
      }
    }
  }
}
