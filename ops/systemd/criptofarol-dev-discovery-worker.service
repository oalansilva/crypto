[Unit]
Description=Cripto Farol DEV Celery discovery worker
After=network-online.target postgresql.service docker.service criptofarol-dev-backend.service
Wants=network-online.target
StartLimitIntervalSec=900
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=__ROOT_DIR__/backend
Environment=DISCOVERY_RESOURCE_PROFILE=dev
Environment=DISCOVERY_INTERNAL_WORKERS=1
Environment=DISCOVERY_MARKET_CACHE_DIR=__ROOT_DIR__/data/storage
Environment=DISCOVERY_SPOOL_DIR=/var/tmp/criptofarol-dev-discovery
StateDirectory=criptofarol-dev-discovery
StateDirectoryMode=0700
MemoryAccounting=yes
MemoryHigh=5G
MemoryMax=6G
MemorySwapMax=512M
OOMPolicy=kill
KillMode=control-group
TimeoutStopSec=30s
SendSIGKILL=yes
Environment=PYTHONPATH=__ROOT_DIR__:__ROOT_DIR__/backend
ExecStart=/bin/bash -lc 'set -euo pipefail; set -a; source "__ROOT_DIR__/backend/.env"; set +a; export CRYPTO_DISCOVERY_CELERY_WORKER_ENABLED=1; exec "__ROOT_DIR__/backend/.venv/bin/celery" -A app.celery_app:celery_app worker --loglevel=INFO --pool=solo --concurrency=1 --prefetch-multiplier=1 --hostname=discovery-dev@%%h -Q discovery'
Restart=on-failure
RestartSec=60

[Install]
WantedBy=multi-user.target
