#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT_DIR"

# BEGIN CANONICAL DEV RESTART
# The Oracle host has canonical, isolated DEV services. Never fall through to
# the legacy 8003/5173 runtime from the DEV source, because those ports belong
# to PROD on this host.
if [[ "$ROOT_DIR" == "/srv/apps/dev/criptofarol/source" ]]; then
  if [[ "${EUID}" -ne 0 ]]; then
    if sudo -n true >/dev/null 2>&1; then
      exec sudo -n "$0" "$@"
    fi
    echo "DEV restart requires root to read backend/.env and restart system services." >&2
    exit 1
  fi

  DEV_BACKEND_UNIT="criptofarol-dev-backend.service"
  DEV_FRONTEND_UNIT="criptofarol-dev-frontend.service"
  DEV_RUNTIME_WORKER_UNIT="criptofarol-dev-runtime-worker.service"
  DEV_DISCOVERY_WORKER_UNIT="criptofarol-dev-discovery-worker.service"
  DEV_BACKEND_PORT="8004"
  DEV_FRONTEND_PORT="5175"

  for unit in "$DEV_BACKEND_UNIT" "$DEV_FRONTEND_UNIT"; do
    if ! systemctl cat "$unit" >/dev/null 2>&1; then
      echo "Missing canonical DEV service: $unit" >&2
      exit 1
    fi
  done

  set -a
  # shellcheck disable=SC1091
  source "$ROOT_DIR/backend/.env"
  set +a

  echo "Running DEV database migrations..."
  (
    cd "$ROOT_DIR/backend"
    "$ROOT_DIR/backend/.venv/bin/alembic" upgrade head
  )

  echo "Building DEV frontend..."
  (
    cd "$ROOT_DIR/frontend"
    VITE_API_URL="/api" VITE_APP_ENV="development" npm run build
  )

  echo "Ensuring DEV canonical candle writer timer..."
  if [[ -x "$ROOT_DIR/install-candle-writer-systemd.sh" ]]; then
    "$ROOT_DIR/install-candle-writer-systemd.sh" --env dev
  else
    echo "Missing install-candle-writer-systemd.sh; candle writer timer not updated." >&2
  fi

  # Fail before stopping anything: a missing installer must not leave Discovery
  # stopped with nothing to start it again.
  if [[ ! -x "$ROOT_DIR/install-discovery-workers-systemd.sh" ]]; then
    echo "Missing or not executable install-discovery-workers-systemd.sh: nothing was stopped or restarted; DEV Discovery was left untouched." >&2
    exit 1
  fi

  # The installer refuses to apply memory limits while Discovery is active or
  # its cgroup still has processes (#1093). Stop Discovery here, always, so a
  # normal restart never trips that guard (#1106). An in-flight search is
  # interrupted and resumes through the #1093 recovery path (lease expiry,
  # lease_interrupted, backoff), spending one attempt. Nothing is killed
  # beyond what `systemctl stop` itself does (SIGTERM, then SIGKILL after
  # TimeoutStopSec).
  echo "Stopping DEV discovery worker before applying its limits..."
  if systemctl cat "$DEV_DISCOVERY_WORKER_UNIT" >/dev/null 2>&1; then
    if ! systemctl stop "$DEV_DISCOVERY_WORKER_UNIT"; then
      echo "DEV discovery worker did not stop ($DEV_DISCOVERY_WORKER_UNIT): memory limits were NOT applied (limites não aplicados); no unit was installed or restarted." >&2
      exit 1
    fi
  else
    echo "Discovery worker unit not installed yet; skipping stop."
  fi

  # Discovery is started exactly once, by the installer's `enable --now`, with
  # the freshly written units. It must not be part of the `systemctl restart`
  # below: two starts per restart would exhaust StartLimitBurst=3/900s (#1093)
  # on the second restart within 15 minutes. There is no automatic
  # `reset-failed`; a start-limit refusal fails this restart with a clear
  # message and the operator repeats it later.
  echo "Ensuring DEV discovery workers..."
  if ! "$ROOT_DIR/install-discovery-workers-systemd.sh"; then
    echo "DEV discovery workers were not installed/started (see above). The discovery worker was stopped by this restart and may still be stopped; backend, frontend and runtime worker were not restarted. Fix the cause and run ./restart again." >&2
    exit 1
  fi
  systemctl show "$DEV_DISCOVERY_WORKER_UNIT" -p MemoryHigh -p MemoryMax -p MemorySwapMax || true

  echo "Restarting canonical DEV services..."
  # Stop the runtime worker before the backend runs schema migration so a
  # long-lived DB session cannot block ALTER TABLE and leave :8004 silent.
  systemctl stop "$DEV_RUNTIME_WORKER_UNIT" || true
  systemctl restart \
    "$DEV_BACKEND_UNIT" \
    "$DEV_FRONTEND_UNIT"

  backend_up=0
  for _ in $(seq 1 30); do
    if curl -fsS --max-time 2 "http://127.0.0.1:${DEV_BACKEND_PORT}/api/health" >/dev/null \
      && curl -fsS --max-time 2 "http://127.0.0.1:${DEV_FRONTEND_PORT}/" >/dev/null; then
      backend_up=1
      break
    fi
    sleep 1
  done
  if [[ "$backend_up" -ne 1 ]]; then
    echo "DEV backend did not become healthy before starting the runtime worker." >&2
    systemctl --no-pager --lines=20 status \
      "$DEV_BACKEND_UNIT" \
      "$DEV_FRONTEND_UNIT" \
      "$DEV_DISCOVERY_WORKER_UNIT" >&2 || true
    exit 1
  fi
  systemctl start "$DEV_RUNTIME_WORKER_UNIT"

  for _ in $(seq 1 30); do
    if curl -fsS --max-time 2 "http://127.0.0.1:${DEV_BACKEND_PORT}/api/health" >/dev/null \
      && curl -fsS --max-time 2 "http://127.0.0.1:${DEV_FRONTEND_PORT}/" >/dev/null \
      && systemctl is-active --quiet "$DEV_RUNTIME_WORKER_UNIT" \
      && systemctl is-active --quiet "$DEV_DISCOVERY_WORKER_UNIT"; then
      echo "crypto DEV backend:  http://127.0.0.1:${DEV_BACKEND_PORT}"
      echo "crypto DEV frontend: http://127.0.0.1:${DEV_FRONTEND_PORT}"
      echo "crypto DEV discovery workers: active"
      systemctl is-active criptofarol-dev-candle-writer.timer >/dev/null 2>&1 \
        && echo "crypto DEV candle writer timer: active" \
        || echo "crypto DEV candle writer timer: inactive" >&2
      exit 0
    fi
    sleep 1
  done

  echo "DEV services did not become healthy after restart." >&2
  systemctl --no-pager --lines=20 status \
    "$DEV_BACKEND_UNIT" \
    "$DEV_FRONTEND_UNIT" \
    "$DEV_RUNTIME_WORKER_UNIT" \
    "$DEV_DISCOVERY_WORKER_UNIT" >&2 || true
  exit 1
fi
# END CANONICAL DEV RESTART

if [[ "$ROOT_DIR" == /srv/apps/dev/criptofarol/* ]]; then
  echo "Refusing restart outside the canonical DEV source." >&2
  echo "Integrate the reviewed branch, then run /srv/apps/dev/criptofarol/source/restart." >&2
  exit 2
fi

if [[ -x ./stop ]]; then
  ./stop
else
  ./stop.sh
fi

if [[ -x ./start ]]; then
  ./start
else
  ./start.sh
fi
