  {
    "name": "bollinger_squeeze",
    "display_name": "Squeeze de Bollinger",
    "description": "Bandas de Bollinger comprimidas dentro do Keltner seguidas de rompimento para cima.",
    "is_example": false,
    "is_prebuilt": true,
    "is_readonly": false,
    "template_data": {
      "indicators": [
        {
          "type": "bbands",
          "alias": "bb",
          "params": {
            "length": 20,
            "std": 2
          }
        },
        {
          "type": "kc",
          "alias": "kc",
          "params": {
            "length": 20,
            "mult": 1.5
          }
        }
      ],
      "entry_logic": "(bb_upper < kc_upper) & (bb_lower > kc_lower) & (close > bb_upper)",
      "exit_logic": "(close < bb_middle) | (bb_upper > kc_upper)",
      "stop_loss": 0.02
    },
    "optimization_schema": {
      "parameters": {
