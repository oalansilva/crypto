          "max": 2.5,
          "default": 2
        },
        "kc_length": {
          "min": 15,
          "max": 30,
          "default": 20
        },
        "kc_mult": {
          "min": 1.2,
          "max": 2.0,
          "default": 1.5
        },
        "stop_loss": {
          "min": 0.01,
          "max": 0.035,
          "default": 0.02
        }
      },
      "correlated_groups": [
        [
          "bb_length",
